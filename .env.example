# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Prisma / Postgres (Project Settings -> Database -> Connection string)
# Pooled connection (PgBouncer, port 6543) for the app runtime:
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) for migrations/seed:
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secret used to authorize the Vercel cron route
CRON_SECRET="generate-a-random-string"
