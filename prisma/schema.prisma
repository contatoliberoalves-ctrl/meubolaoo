generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  player
  admin

  @@map("bolao_role")
}

enum Stage {
  group
  r16
  qf
  sf
  final

  @@map("bolao_stage")
}

model Profile {
  id         String   @id @db.Uuid
  name       String
  emblem     String   @default("⚽")
  role       Role     @default(player)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  predictions Prediction[]
  user_badges UserBadge[]

  @@map("bolao_profiles")
}

model Group {
  code  String  @id
  name  String
  teams Team[]
  matches Match[]

  @@map("bolao_groups")
}

model Team {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  flag       String
  group_code String
  group      Group   @relation(fields: [group_code], references: [code])

  home_matches Match[] @relation("home")
  away_matches Match[] @relation("away")

  @@map("bolao_teams")
}

model Match {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_code   String?
  group        Group?    @relation(fields: [group_code], references: [code])
  stage        Stage     @default(group)
  matchday     Int?
  home_team_id String?   @db.Uuid
  away_team_id String?   @db.Uuid
  home_team    Team?     @relation("home", fields: [home_team_id], references: [id])
  away_team    Team?     @relation("away", fields: [away_team_id], references: [id])
  kickoff_at   DateTime  @db.Timestamptz(6)
  home_score   Int?
  away_score   Int?
  locked       Boolean   @default(false)

  predictions Prediction[]

  @@map("bolao_matches")
}

model Prediction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  match_id   String   @db.Uuid
  home       Int
  away       Int
  points     Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user  Profile @relation(fields: [user_id], references: [id])
  match Match   @relation(fields: [match_id], references: [id])

  @@unique([user_id, match_id])
  @@map("bolao_predictions")
}

model PrizeConfig {
  slot        String @id
  prize_label String

  @@map("bolao_prizes_config")
}

model Badge {
  id          String @id
  title       String
  description String
  icon        String
  sort_order  Int

  user_badges UserBadge[]

  @@map("bolao_badges")
}

model UserBadge {
  user_id     String   @db.Uuid
  badge_id    String
  unlocked_at DateTime @default(now()) @db.Timestamptz(6)

  user  Profile @relation(fields: [user_id], references: [id])
  badge Badge   @relation(fields: [badge_id], references: [id])

  @@id([user_id, badge_id])
  @@map("bolao_user_badges")
}

// ─── Workshop ────────────────────────────────────────────────────────────────

enum WStatus {
  agendada
  ao_vivo
  gravada

  @@map("workshop_lesson_status")
}

enum WCommentStatus {
  pending
  approved
  rejected

  @@map("workshop_comment_status")
}

model WStudent {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String     @unique
  password   String
  points     Int        @default(0)
  created_at DateTime   @default(now()) @db.Timestamptz(6)

  watched  WWatched[]
  comments WComment[]

  @@map("workshop_students")
}

model WLesson {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date        String
  time        String
  materia     String
  palestrante String
  youtube_url String   @default("")
  status      WStatus  @default(agendada)
  image_url   String   @default("")
  sort_order  Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  watched  WWatched[]
  comments WComment[]

  @@map("workshop_lessons")
}

model WWatched {
  student_id String   @db.Uuid
  lesson_id  String   @db.Uuid
  watched_at DateTime @default(now()) @db.Timestamptz(6)

  student WStudent @relation(fields: [student_id], references: [id])
  lesson  WLesson  @relation(fields: [lesson_id], references: [id])

  @@id([student_id, lesson_id])
  @@map("workshop_watched")
}

model WMaterial {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materia    String
  title      String
  url        String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("workshop_materials")
}

model WAnnouncement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text       String
  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("workshop_announcements")
}

model WComment {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_id    String         @db.Uuid
  student_id   String         @db.Uuid
  student_name String
  text         String
  status       WCommentStatus @default(pending)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)

  lesson  WLesson  @relation(fields: [lesson_id], references: [id])
  student WStudent @relation(fields: [student_id], references: [id])

  @@map("workshop_comments")
}
